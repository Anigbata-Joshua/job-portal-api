{
  "info": {
    "_postman_id": "job-portal-api-collection",
    "name": "Job Portal API Remediation & Scrutiny Testing Suite",
    "description": "Comprehensive testing suite for all endpoints, including security validation, XSS sanitization, Refresh Token Rotation, concurrency counters, scheduling conflict gates, and RBAC edge cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register (Seeker)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jane Doe\",\n  \"email\": \"jane.seeker@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"job_seeker\"\n}"
            },
            "url": {
              "raw": "{{url}}/api/auth/register",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new job seeker. Expects 201 Created and HttpOnly cookies."
          }
        },
        {
          "name": "Register (Employer)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Corporate\",\n  \"email\": \"john.employer@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"employer\"\n}"
            },
            "url": {
              "raw": "{{url}}/api/auth/register",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new employer."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"jane.seeker@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            },
            "url": {
              "raw": "{{url}}/api/auth/login",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Log in to the system. Automatically sets environment tokens upon success."
          }
        },
        {
          "name": "Refresh Token Rotation (RTR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.accessToken) {",
                  "        pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "    }",
                  "    if (jsonData.refreshToken) {",
                  "        pm.environment.set(\"refreshToken\", jsonData.refreshToken);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{url}}/api/auth/refresh",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "auth",
                "refresh"
              ]
            },
            "description": "Rotates refresh token. Send previous refreshToken. If reused, all sessions are automatically revoked."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{url}}/api/auth/logout",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "auth",
                "logout"
              ]
            },
            "description": "Clears cookies and invalidates refresh token in the DB."
          }
        },
        {
          "name": "EDGE CASE: Weak Password Register Attempt",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bad Password Seeker\",\n  \"email\": \"bad.seeker@example.com\",\n  \"password\": \"123456\",\n  \"role\": \"job_seeker\"\n}"
            },
            "url": {
              "raw": "{{url}}/api/auth/register",
              "host": [
                "{{url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Checks the Zod validation and password complexity. Expects 400 Bad Request."
          }
        }
      ]
    },
